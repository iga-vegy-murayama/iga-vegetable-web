---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
---
<Base title="プライバシーポリシー">
  <PageHeader title="プライバシーポリシー" crumbs={[{ label: 'プライバシーポリシー', href: '/privacy/' }]} />
  <section class="section"><div class="container prose">
    <p><Todo>現行サイトのプライバシーポリシー（下書き）を移して整える。アクセス解析（Google Analytics）とフォームのスパム対策（Cloudflare Turnstile）の記載を含める</Todo></p>
  </div></section>
</Base>
