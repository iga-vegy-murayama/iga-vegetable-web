---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, formatDate } from '../../lib/wp';
export async function getStaticPaths() {
  return (await getPosts()).map((p) => ({ params: { id: String(p.id) }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.title} description={p.excerpt.slice(0, 120)}>
  <PageHeader eyebrow={p.categories.join('・') || 'NEWS'} title={p.title} crumbs={[{ label: 'お知らせ', href: '/news/' }]}>
    <p style="margin:0"><time datetime={p.date}>{formatDate(p.date)}</time></p>
  </PageHeader>
  <section class="section"><div class="container prose post">
    <Fragment set:html={p.html} />
    <p style="margin-top:3rem"><a href="/news/">← お知らせの一覧へ</a></p>
  </div></section>
</Base>
<style>
  .post :global(img) { border-radius: var(--radius); margin: 1.6em 0; }
  .post :global(figure) { margin: 0; }
</style>
